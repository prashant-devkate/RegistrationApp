@page
@{
    Layout = "_BlankLayout";
    ViewData["Title"] = "Chinchpur Pangul Premier League 2026 | RD Events";
}

@section Styles {
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
}

<div class="landing-minimal">

    <!-- ===================== MAIN: Banner as full-bleed background ===================== -->
    <div class="landing-content">

        <div class="banner-bg">
            <img src="~/images/chinchpur-pangul-banner.jpeg"
                 alt="Chinchpur Pangul Premier League 2026 – Season 2" />
            <div class="banner-shade"></div>
        </div>

        <a href="/register" class="cta-block" aria-label="Register now for auction">
            Register Now For Auction
        </a>

        <!-- SEO / accessibility only -->
        <h1 class="sr-only">Chinchpur Pangul Premier League 2026 – Season 2</h1>
        <p class="sr-only">
            Join thousands of cricket enthusiasts and register for our premier tournament.
        </p>

    </div>

    <!-- ===================== SIDEBAR: RD Events Logo ===================== -->
    <div class="landing-info">
        <div class="ad-space">
            <span class="ad-label">Presented By</span>
            <div class="rd-logo">
                <img src="~/images/rd-events-logo.png" alt="RD Events" />
            </div>
        </div>
    </div>

</div>