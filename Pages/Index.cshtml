@page
@{
    Layout = "_BlankLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
}

<div class="landing-minimal">
    <!-- Left Panel: Hero Content -->
    <div class="landing-content">
        <div class="landing-content-inner">
            <h1>
                Cricket
                <span>More than just a Sport</span>
            </h1>
            <p class="tagline">It's a "Religion" in India</p>
            <p>Join thousands of cricket enthusiasts and register for our premier tournament. Experience the passion, skill, and spirit of the game.</p>
            <a href="/register" class="register-button">Register Now For Auction</a>
        </div>
    </div>

    <!-- Right Panel: Info & Categories -->
    <div class="landing-info">
        <div class="info-content">
            <div class="info-title">Categories</div>
            <div class="info-row">
                <div class="info-item">
                    <div class="info-label">🏏 Batsman</div>
                    <div class="info-value">₹500</div>
                </div>
                <div class="info-item">
                    <div class="info-label">🎯 Bowler</div>
                    <div class="info-value">₹500</div>
                </div>
                <div class="info-item">
                    <div class="info-label">⭐ All-Rounder</div>
                    <div class="info-value">₹500</div>
                </div>
            </div>
        </div>
    </div>
</div>
