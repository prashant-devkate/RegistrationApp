@page
@{
    Layout = "_BlankLayout";
    ViewData["Title"] = "Cricket Tournament | RD Events";
}

@section Styles {
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
}

<div class="landing-minimal">
    <!-- Left Panel: Hero Content -->
    <div class="landing-content">
        <div class="landing-content-inner">
            <h1>
                Cricket
                <span>More than just a Sport</span>
            </h1>
            <p class="tagline">It's a "Religion" in India</p>
            <p>Join thousands of cricket enthusiasts and register for our premier tournament. Experience the passion, skill, and spirit of the game.</p>

            <a href="/register" class="register-button">Register Now For Auction</a>
        </div>
    </div>

    <!-- Right Panel: RD Events Logo on clean white background -->
    <div class="landing-info">
        <div class="logo-showcase">
            <img src="~/images/rd-events-logo.png" alt="RD Events" />
        </div>
    </div>
</div>