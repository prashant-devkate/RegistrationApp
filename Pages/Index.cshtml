@page
@{
    Layout = "_BlankLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
}

<div class="landing-minimal">
    <!-- Left Panel: Hero Content -->
    <div class="landing-content">
        <div class="landing-content-inner">

            <div class="tournament-badge">
                <span>🏆</span> Premier Tournament
            </div>

            <h1>
                Cricket
                <span>More than just a Sport</span>
            </h1>
            <p class="tagline">It's a "Religion" in India</p>
            <p>Join thousands of cricket enthusiasts and register for our premier tournament. Experience the passion, skill, and spirit of the game.</p>

            <!-- RD Events Logo – placed just above the registration button -->
            <div class="rd-logo">
                <img src="~/images/rd-events-logo.jpeg" alt="RD Events" />
            </div>

            <a href="/register" class="register-button">Register Now For Auction</a>
        </div>
    </div>

    <!-- Right Panel: Event Image -->
    <div class="landing-info">
        <div class="event-image-frame">
            <img src="~/images/cricket-tournament-banner.png" alt="Cricket Tournament Banner" />
        </div>
    </div>
</div>