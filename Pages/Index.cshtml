@page
@{
    Layout = "_BlankLayout";
    ViewData["Title"] = "Cricket Tournament | RD Events";
}

@section Styles {
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
}

<div class="landing-minimal">
    <!-- Left Panel: Banner Hero + Content -->
    <div class="landing-content">
        <!-- Event Banner used as eye-catching hero background -->
        <div class="banner-bg">
            <img src="~/images/chinchpur-pangul-banner.jpeg" alt="Chinchpur Pangul Premier League 2026 - Season 2" />
        </div>
        <div class="banner-overlay"></div>

        <div class="landing-content-inner">
            <h1>
                Cricket
                <span>More than just a Sport</span>
            </h1>
            <p>Join thousands of cricket enthusiasts and register for our premier tournament. Experience the passion, skill, and spirit of the game.</p>

            <a href="/register" class="register-button">Register Now For Auction</a>
        </div>
    </div>

    <!-- Right Panel: Compact Ad Space with RD Events Logo -->
    <div class="landing-info">
        <div class="ad-space">
            <span class="ad-label">Presented By</span>
            <div class="rd-logo">
                <img src="~/images/rd-events-logo.png" alt="RD Events" />
            </div>
        </div>
    </div>
</div>
